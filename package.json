{
    "name": "monorepo",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "setup": "npm install",
        "dev": "npx concurrently --kill-others --raw \"node server.js\" \"npm run dev --prefix apps/web\"",
        "build": "npm run build --prefix apps/web",
        "start": "node server.js",
        "lint": "npm run lint --prefix apps/web"
    },
    "devDependencies": {
        "concurrently": "^10.0.4",
        "knip": "^6.32.1"
    },
    "workspaces": [
        "apps/*"
    ]
}